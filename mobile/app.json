{
  "expo": {
    "name": "SiteGuard",
    "slug": "siteguard-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "siteguard",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f1e"
    },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.siteguard.mobile" },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a0f1e"
      },
      "package": "com.siteguard.mobile"
    },
    "web": { "bundler": "metro", "favicon": "./assets/images/icon.png" },
    "plugins": ["expo-router", "expo-secure-store", "expo-font"],
    "experiments": { "typedRoutes": true }
  }
}
